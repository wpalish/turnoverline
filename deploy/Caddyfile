# PUBLIC_DOMAIN must be your real hostname and match PUBLIC_ORIGIN (without https://).
{$PUBLIC_DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:8792 {
        health_uri /healthz
        health_interval 30s
        health_timeout 3s
        health_headers {
            Host {$PUBLIC_DOMAIN}
        }
    }
}
